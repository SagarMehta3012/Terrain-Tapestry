# Copy this file to .env and fill in real values before deploying.
# The contact form works without these too — messages are simply
# saved to server/messages.log.json instead of emailed.

PORT=3000

# SMTP credentials used to email contact-form submissions.
# Gmail example: create an "App Password" at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Where contact-form messages should be delivered (defaults to SMTP_USER)
CONTACT_TO=mehtareshamc@gmail.com
